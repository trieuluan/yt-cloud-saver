{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Cloud Saver",
  "version": "1.0.0",
  "identifier": "com.louis.yt-cloud-saver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT Cloud Saver",
        "width": 520,
        "height": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
