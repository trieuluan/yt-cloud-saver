{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Cloud Saver",
  "version": "1.2.31",
  "identifier": "com.louis.yt-cloud-saver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT Cloud Saver",
        "width": 520,
        "height": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../../extension": "extension"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQ0Y1MTZGRTYxRkY5Q0YKUldUUCtSL21iMUhQckROcWQ4VXNPeElURUNKc1k3dmNvZDJUb1B4M2c4UEpKM1ZQajFtMUlmMngK",
      "endpoints": [
        "https://github.com/trieuluan/yt-cloud-saver/releases/latest/download/latest.json"
      ]
    }
  }
}
